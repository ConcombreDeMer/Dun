# Modèle des variables d'environnement de Dun. Ce fichier est versionné :
# il ne contient que des valeurs factices, jamais de vraie valeur.
#
# Copier ce fichier vers `.env.development` (builds Debug, Metro) et vers
# `.env.production` (archives Release), puis remplir les valeurs depuis les
# tableaux de bord. Ces deux fichiers sont ignorés par Git.
# Détails : docs/environnements.md
#
# Toutes les variables `EXPO_PUBLIC_*` sont PUBLIQUES : Expo les copie en clair
# dans le bundle de l'app, n'importe qui peut les lire. N'y mettre aucun secret.

# URL du projet Supabase (dev ou prod selon le fichier).
# Publique. À mettre dans `.env.development` et `.env.production`.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co

# Clé « anon » du même projet Supabase. Publique par conception : la sécurité
# repose sur les règles RLS de la base, pas sur cette clé.
# Publique. À mettre dans `.env.development` et `.env.production`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=<cle-anon-du-projet>

# Clé API publique iOS de RevenueCat (préfixe `appl_`, ou clé « Test Store »
# en dev si on en utilise une).
# Publique. À mettre dans `.env.development` et `.env.production`.
EXPO_PUBLIC_REVENUECAT_KEY=appl_<cle-publique-revenuecat>

# Variables Dun+ temporaires : elles disparaîtront en phase 3 (table des droits).
# Publiques. À mettre dans `.env.development` et dans `.env.production`.
# Valeur par défaut : `false`. `npm run ios:device-dev` refuse de lancer le
# build s'il en manque une dans `.env.development`.
#
# `true` donne Dun+ à tout le monde (bêta).
EXPO_PUBLIC_BETA_PREMIUM=false
# `true` bloque l'accès à l'app sans abonnement Dun+.
EXPO_PUBLIC_REQUIRE_PREMIUM_ACCESS=false

# --- Hors bundle ---
#
# SENTRY_AUTH_TOKEN : jeton SECRET, lu uniquement par la phase de build Xcode
# qui envoie les symboles à Sentry. Il se met dans `.env.local`, et jamais dans
# `.env.development`, `.env.production` ou `.env`. `.env.local` ne doit
# contenir aucune variable `EXPO_PUBLIC_*` (il passerait avant
# `.env.production`).
# SENTRY_AUTH_TOKEN=<jeton-sentry>
